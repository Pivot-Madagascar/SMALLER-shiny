power1_c <- function(exp) {
cppFunction('int add1_c(int x) {
int sum = x + 1;
return sum;
}')
function(x) {
exp1 <- add1_c(exp)
x ^ exp1
}
}
power1_r <- function(exp) {
add1_r <- function(x){
return(x+1)
}
function(x) {
exp1 <- add1_r(exp)
x ^ exp1
}
}
square_c <- power1_c(2)
square_r <- power1_r(2)
input_vec <- as.matrix(1:5, ncol = 1)
apply(input_vec, 1, square_c)
apply(input_vec, 1, square_r)
cl <- makeCluster(2)
registerDoParallel(cl)
parApply(cl, input_vec, 1, square_c)
parApply(cl, input_vec, 1, square_r)
cppFunction('int add1_c(int x) {
int sum = x + 1;
return sum;
}')
cl <- makeCluster(2)
registerDoParallel(cl)
clusterExport(cl, c("add1_c"))
parApply(cl, input_vec, 1, square_c)
parApply(cl, input_vec, 1, square_r)
#testing with foreach
foreach_out <- foreach(i=1:length(input_vec)) %do% {
square(input_vec[i,])
}
#testing with foreach
foreach(i=1:length(input_vec), .combine = 'c') %do% {
square(input_vec[i,])
}
foreach_out_par <- foreach(i=1:length(input_vec), .combine = 'c') %dopar% {
square(input_vec[i,])
}
