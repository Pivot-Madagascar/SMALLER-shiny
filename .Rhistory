library(stringr)
library(tidylog)
library(dplyr)
input.vec <- str_split(input, pattern = "\n")[[1]]
#get flow rate per valve
flow.df <- data.frame(valve = character(length(input.vec)),
flow = numeric(length(input.vec)))
for(i in 1:length(input.vec)){
flow.df$valve[i] <- substr(input.vec[i], 7,8)
flow.df$flow[i] <- as.numeric(gsub(";", "", substr(input.vec[i],24,25)))
}
#get connections for each valve
valve.net <- data.frame(input = input.vec) %>%
tidyr::separate(input, into = c("flow", "links"), sep = ";") %>%
mutate(valve = substr(flow, 7,8)) %>%
mutate(links = gsub(" tunnels lead to valves ", "", links)) %>%
#some typos, fix those
mutate(links = gsub(" tunnel leads to valve ", "", links)) %>%
select(-flow) %>%
arrange(valve)
#this seems hacky but should work
net.mat <- matrix(0, nrow = nrow(valve.net), ncol = nrow(valve.net))
colnames(net.mat) <- sort(flow.df$valve)
rownames(net.mat) <- sort(flow.df$valve)
#loop over this to find links
for(i in 1:nrow(valve.net)){
focal.valve <- valve.net$valve[i]
this.links <- trimws(unlist(str_split(valve.net$links[i], "\\,")))
net.mat[colnames(net.mat)==focal.valve, rownames(net.mat) %in% this.links] <- 1
}
#start at AA, have 30 minutes, takes one minute to move and one minute to open
#function to get best connection
find_best <- function()
#start at AA, have 30 minutes, takes one minute to move and one minute to open
#function to get best connection
find_best <- function(current.valve){
connections <- trimws(unlist(str_split(valve.net$links[valve.net$valve == curr.loc], "\\,")))
#we want to only go to a closed connection and also choose the one with highest flow
best.connex <- flow.df %>%
filter(valve %in% connections) %>%
filter(valve %in% closed.valves) %>%
filter(flow == max(flow))
}
#identify connected valve with highest flow
best.connex <- find_best(curr.loc)
