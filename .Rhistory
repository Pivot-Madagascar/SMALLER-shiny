#' landing_map UI Function
#'
#' @description A shiny Module.
#'
#' @param id,input,output,session Internal parameters for {shiny}.
#'
#' @noRd
#'
#' @importFrom shiny NS tagList
#' @importFrom leaflet leafletOutput renderLeaflet
mod_landing_map_ui <- function(id){
ns <- NS(id)
# tagList(
#   fluidRow(
#     column(12,
#            leafletOutput(ns("map"))
#     )
#   )
# )
leafletOutput(ns("map"), height = "60vh"),
#' landing_map UI Function
#'
#' @description A shiny Module.
#'
#' @param id,input,output,session Internal parameters for {shiny}.
#'
#' @noRd
#'
#' @importFrom shiny NS tagList
#' @importFrom leaflet leafletOutput renderLeaflet
mod_landing_map_ui <- function(id){
ns <- NS(id)
# tagList(
#   fluidRow(
#     column(12,
#            leafletOutput(ns("map"))
#     )
#   )
# )
bodyPanel(
leafletOutput(ns("map"), height = "60vh"),
absolutePanel(class = "panel panel-default", style = "opacity: 0.9",
draggable = TRUE,
top = "auto", left = "auto", right = 40, bottom = 60,
width = 300, height = "auto",
verbatimTextOutput("comm_fkt_name")
)
)
}
?bodyPanel
