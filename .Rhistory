prev2inc <- function(prev){
2.616*prev-(3.596*prev^2) + (1.594*prev^3)
}
x_prev <- seq(0,0.6,0.05)
plot(x_prev, prev2inc(x_prev))
plot(x_prev, prev2inc(x_prev)^-1)
plot(x_prev, prev2inc(x_prev))
plot(x_prev, prev2inc(x_prev)*1000)
x_prev <- seq(0,0.8,0.05)
plot(x_prev, prev2inc(x_prev)*1000)
