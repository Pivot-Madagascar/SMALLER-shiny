power1_c <- function(exp) {
cppFunction('int add1_c(int x) {
int sum = x + 1;
return sum;
}')
function(x) {
exp1 <- add1_c(exp)
x ^ exp1
}
}
power1_r <- function(exp) {
add1_r <- function(x){
return(x+1)
}
function(x) {
exp1 <- add1_r(exp)
x ^ exp1
