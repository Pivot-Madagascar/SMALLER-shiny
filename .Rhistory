library(synchrony)
# Compute phase synchrony
t1=runif(100)
t2=runif(100)
sync=phase.sync(t1, t2)
sync
time_df <- data.frame(x = 1:100,
t1,
t2)
library(synchrony)
library(ggplot2)
sync=phase.sync(t1, t2)
ggplot(time_df, aes(x = x)) +
geom_line(aes(y = t1)) +
geom_line(aes(y = t2))
ggplot(time_df, aes(x = x)) +
geom_line(aes(y = t1)) +
geom_line(aes(y = t2), color = "blue")
t3 <- t1 + rnorm(100)
ggplot(time_df, aes(x = x)) +
geom_line(aes(y = t1)) +
geom_line(aes(y = t2), color = "blue") +
geom_line(aes(y = t3), color = "red")
t3 <- t1 + rnorm(100, mean = 0, sd = 0.1)
time_df <- data.frame(x = 1:100,
t1,
t2,
t3)
ggplot(time_df, aes(x = x)) +
geom_line(aes(y = t1)) +
geom_line(aes(y = t2), color = "blue") +
geom_line(aes(y = t3), color = "red")
sync=phase.sync(t1, t2, t3)
sync=phase.sync(t1, t2)
sync2 <- phase.sync(t1,t3)
sync2
sync
# Distribution of phase difference
hist(sync$deltaphase$mod_phase_diff_2pi)
hist(sync2$deltaphase$mod_phase_diff_2pi)
# Compute concordant peaks
p=peaks(t1, t2, nrands=100)
# Find proportion of time steps where both time series peak together
p$peaks
p2 <- peaks(t1, t3, nrands = 100)
p2$peaks
p
p2
p$rands
# Plot (null) distribution of proportion of time steps where both time
# series peak together
hist(p$rands)
hist(p2$rands)
