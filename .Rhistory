install.packages("unmarked")
library(unmarked)
# Simulated data for demonstration (you should replace this with your own data)
# Assume you have a vector `count` representing the number of detections for each sample unit,
# and a matrix `covariates` containing covariates for each sample unit.
set.seed(123)
count <- rpois(100, lambda = 5)
covariates <- matrix(rnorm(500), ncol = 5)
# Create the unmarked data object
data_um <- unmarkedFrame(count = count, covariates = covariates)
?unmarkedFrame
# Create the unmarked data object
data_um <- unmarkedFrame(y= count, siteCovs = covariates)
?occu
data(frogs)
pferUMF <- unmarkedFrameOccu(pfer.bin)
plot(pferUMF, panels=4)
# add some fake covariates for illustration
siteCovs(pferUMF) <- data.frame(sitevar1 = rnorm(numSites(pferUMF)))
# observation covariates are in site-major, observation-minor order
obsCovs(pferUMF) <- data.frame(obsvar1 = rnorm(numSites(pferUMF) * obsNum(pferUMF)))
(fm <- occu(~ obsvar1 ~ 1, pferUMF))
confint(fm, type='det', method = 'normal')
confint(fm, type='det', method = 'profile')
fm
