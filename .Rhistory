library(rnoaa)
library(lubridate)
library(dplyr)
#download function with try-catch
arc2_try <- function(download_date){
tryCatch(
expr = {
arc2(date = download_date, box = bounding.box)
},
error = function(e){
message("error:", download_date)
return(NA)
}
)
}
date.range <- seq(as.Date("2022-01-01"), as.Date("2022-03-01"), by = "day")
bounding.box <-  c(xmin = 47.1, ymin = -22, xmax = 48, ymax = -20.2)
#record dates that don't work
error.dates <- as.Date(c())
#must iterate over individuals days because some dates don't work
date.seq <- seq.Date(date.range[1], tail(date.range,1), by = "month")
i =1
this.month <- date.seq[i]
this.dates <- date.range[year(date.range)==year(this.month) & month(date.range)==month(this.month)]
#download
#iterate over each individual day
month_list <- list()
#loop over each day in a month, will skip dates with errors
for(j in 1:length(this.dates)){
this.download <- arc2_try(this.dates[j])
if(is.na(this.download)){
error.dates <- c(error.dates, this.dates[j])
next
}
month_list[[j]] <- this.download[[1]]
}
this.month.download <- bind_rows(month_list)
table(this.month.download$date)
