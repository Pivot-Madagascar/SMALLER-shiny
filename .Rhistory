library(Rcpp)
power1 <- function(exp) {
cppFunction('int add1(int x) {
int sum = x + 1;
return sum;
}')
function(x) {
exp1 <- add1(exp)
x ^ exp1
}
}
square <- power1(2)
cube <- power1(3)
input_vec <- as.matrix(1:100, ncol = 1)
apply(input_vec, 1, square)
cl <- makeCluster(2)
registerDoParallel(cl)
parApply(cl, input_vec, 1, square)
#testing with foreach
par_out <- foreach(1=1:length(input_vec)) %do% {
#testing with foreach
